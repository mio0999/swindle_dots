{
  "$schema": "https://github.com",
  "logo": {
    "type": "small",
    "source": "alpine",
    "color": {
      "1": "light_cyan",
      "2": "light_cyan"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " -> ",
    "brightColor": true,
    "color": {
      "keys": "light_cyan",
      "title": "light_cyan",
      "separator": "light_blue"
    },
    "key": {
      "width": 0
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "outputColor": "light_blue"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "host",
      "key": "Host"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk"
    },
    "break",
    "colors",
    "break"
  ]
}

