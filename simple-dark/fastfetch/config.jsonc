{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "gentoo_small",
    "color": {
      "1": "38;2;255;255;255",
      "2": "38;2;255;255;255"
    },
    "padding": {
      "right": 3
    }
  },
    "display": {
    "separator": " -> ",
    "color": {
      "keys": "38;2;57;57;230",
      "title": "38;2;57;57;230"
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "Host" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "packages", "key": "Packages" },
    { "type": "wm", "key": "WM" }, 
    { "type": "cpu", "key": "CPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk", "folders": "/" },
    "break",
    {
      "type": "colors",
      "symbol": "blocks"
    },
    "break"
  ]
}
