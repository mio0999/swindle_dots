{
    // bar
    "layer": "top",
    "position": "bottom",
    "height": 24,
    "margin-left": 146,
    "margin-right": 600,
    "margin-bottom": 3,

    // layout
    "modules-left": ["dwl/tags", "custom/sep1", "clock#date", "custom/sep2"],
    "modules-center": ["clock#time"],
    "modules-right": ["custom/sep3", "memory", "custom/sep4", "pulseaudio", "custom/sep5", "backlight", "custom/sep6", "battery"],

    // tags
    "dwl/tags": { "num-tags": 9 },

    // clock
    "clock#date": { "format": "{:%m/%d/%Y}" },
    "clock#time": { "format": "{:%H:%M:%S}", "interval": 1 },

    // system
    "memory":     { "format": "RAM {percentage}%" },
    "pulseaudio": { "format": "VOL {volume}%", "format-muted": "VOL mute" },
    "backlight":  { "format": "BRI {percent}%" },
    "battery": {
        "format": "BAT {capacity}%",
        "format-discharging": "BAT {capacity}%",
        "format-charging": "BAT {capacity}%+",
        "format-full": "BAT {capacity}%",
        "format-plugged": "BAT {capacity}%"
    },

    // separators
    "custom/sep1": { "format": "|", "tooltip": false },
    "custom/sep2": { "format": "|", "tooltip": false },
    "custom/sep3": { "format": "|", "tooltip": false },
    "custom/sep4": { "format": "|", "tooltip": false },
    "custom/sep5": { "format": "|", "tooltip": false },
    "custom/sep6": { "format": "|", "tooltip": false }
}
